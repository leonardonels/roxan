# Copy to scripts/roxan.env (gitignored) and fill in what you use. Both are optional:
# without them the scripts only report to Glance and the journal.

# ntfy (https://ntfy.sh or self-hosted): pick an unguessable topic and subscribe to it from the phone app.
NTFY_URL=
#NTFY_URL=https://ntfy.sh/roxan-change-me-to-something-random

# Telegram: create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
