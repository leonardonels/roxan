# Environment variables (secrets: tunnel tokens, DB passwords, ...)
*.env

# Editor swap/backup files
*.swp
*.swo
*~
*.bak

# pi-hole data
data/pi-hole/*
!data/pi-hole/.gitkeep

# InvokeAI data
data/invokeai/*
!data/invokeai/.gitkeep

# ollama data
data/ollama/*
!data/ollama/.gitkeep

# Portainer data
data/portainer-io/*
!data/portainer-io/.gitkeep

# Vaultwarden data
data/vaultwarden/*
!data/vaultwarden/.gitkeep

# Crafty data
data/crafty/*
!data/crafty/.gitkeep

# Immich data
data/immich-app/*
!data/immich-app/.gitkeep

# n8n data
data/n8n/*
!data/n8n/data/.gitkeep
!data/n8n/files/.gitkeep

# sam3 - quick toy container
data/sam3/*
!data/sam3/.gitkeep

# CUDA AI lab workspace (mounted as /workspace)
data/cuda/*
!data/cuda/README.md

# FloraTech checkout
data/floratech/repo/*
!data/floratech/repo/.gitkeep

# mmr ROS workspace (sources + build output, ~1 GB)
data/mmr/*
!data/mmr/.gitkeep

# Scrutiny SMART database and InfluxDB (root-owned)
data/scrutiny/*
!data/scrutiny/.gitkeep

# OpenLinkHub: keep the config, not the state it rewrites at runtime (profiles, RGB, LED, cluster)
data/openlinkhub/database/*
!data/openlinkhub/database/scheduler.json

# OpenRGB: keep the config (detector allowlist), not logs/profiles
data/openrgb/*
!data/openrgb/OpenRGB.json

# maintenance scripts: notification secrets and the generated Glance status
scripts/roxan.env
data/glance/assets/roxan-status.json
